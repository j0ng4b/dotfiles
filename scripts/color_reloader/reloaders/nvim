# Generic base16 palette consumed by lua/theme.lua (mini.base16).
output="$CONFIG_HOME/nvim/lua/colors.lua"

reload() {
    for sock in "${XDG_RUNTIME_DIR}"/nvim.*.0; do
        [ -S "$sock" ] || continue
        nvim --clean --headless --server "$sock" \
            --remote-send "<Cmd>lua require('theme').reload()<CR>"
    done
}
