#!/usr/bin/env sh
#
# color-reloader
#
# Single source of truth for colors.
#
#   $XDG_CONFIG_HOME/sysconf/theme        "<scheme>/<mode>", e.g. "gruvbox/dark"
#                 v
#   palette  <- provider/<scheme>        (dynamic: matugen, ...)   or
#            <- color/<scheme>/<mode>    (static base16 file)
#            +   alias                   (semantic names: bg, fg, accent...)
#                 v
#   $SCRIPT_CACHE_DIR/palette
#                 v
#   every *installed* tool in reloaders/ :  generate (template -> config file)
#                                           reload   (hook, run in parallel)
#

export CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}

base_dir="$root/color_reloader"
theme_dir="$CONFIG_HOME/sysconf"
theme_file="$theme_dir/theme"
disabled_file="$theme_dir/color-reloader.disabled"
palette_file="$SCRIPT_CACHE_DIR/palette"
pidfile="$SCRIPT_CACHE_DIR/watcher.pid"

mkdir -p "$theme_dir" "$SCRIPT_CACHE_DIR"
if [ ! -e "$theme_file" ]; then
    echo "gruvbox/${COLOR_MODE:-dark}" > "$theme_file"
fi


##
## Theme / palette
##

_theme() {
    head -n1 "$theme_file" 2>/dev/null | tr -d '\n'
}

# Sets $theme, $scheme and $mode from the theme file.
_parse_theme() {
    theme="$(_theme)"
    scheme="${theme%%/*}"

    case "$theme" in
        */*) mode="${theme#*/}" ;;
        *)   mode="${COLOR_MODE:-dark}" ;;
    esac
}

_scheme_exists() {
    [ -d "$base_dir/color/$1" ] || [ -f "$base_dir/provider/$1" ]
}

# Resolves the current theme into $palette_file (one "key hex" pair per line).
_build_palette() {
    _parse_theme
    raw="$SCRIPT_CACHE_DIR/palette.raw"

    if [ -f "$base_dir/provider/$scheme" ]; then
        sh "$base_dir/provider/$scheme" "$mode" > "$raw" || {
            error "color-reloader: provider '$scheme' failed"
            return 1
        }
    elif [ -f "$base_dir/color/$scheme/$mode" ]; then
        cp "$base_dir/color/$scheme/$mode" "$raw"
    elif [ -f "$base_dir/color/$scheme/dark" ]; then
        warn "color-reloader: '$scheme' has no '$mode' variant, falling back to dark"
        mode=dark
        cp "$base_dir/color/$scheme/$mode" "$raw"
    else
        error "color-reloader: theme not found: '$theme'"
        return 1
    fi

    aliases="$base_dir/alias"
    [ -f "$aliases" ] || aliases=/dev/null

    awk -f "$base_dir/lib/palette.awk" "$raw" "$aliases" > "$palette_file.tmp" || {
        rm -f "$palette_file.tmp"
        error "color-reloader: invalid palette for '$theme'"
        return 1
    }
    mv "$palette_file.tmp" "$palette_file"
}

# color <name> prints the hex (without '#') correspondent of color name in the
# palette.
color() {
    awk -v name="$1" '$1 == name { print $2 }' "$palette_file"
}

# render <template> <output>: fills a template with the current palette.
#   {base00} -> 1d2021
#   {base00:#} -> #1d2021
#   {base00:rgb} -> 29,32,33
render() {
    template_path="$base_dir/template/$1"
    output_path="$2"
    [ -f "$template_path" ] || {
        warn "color-reloader: template '$1' not found"
        return 1
    }

    mkdir -p "$(dirname "$output_path")"
    awk -v palette_file="$palette_file" -f "$base_dir/lib/render.awk" "$template_path" > "$output_path.tmp" \
        && mv "$output_path.tmp" "$output_path"
}


##
## Reloaders
##

# Loads a reloader definition into the current shell.
#
# A definition may set:
#     bin, template, output
#
# and override:
#     detect(), generate(), reload()
_load_reloader() {
    name="$1"
    bin="$1"
    template="$1"
    output=""

    detect()   { command -v "$bin" >/dev/null 2>&1; }
    generate() { [ -z "$output" ] || render "$template" "$output"; }
    reload()   { :; }

    . "$base_dir/reloaders/$name"
}

_is_disabled() {
    grep -qxF "$1" "$disabled_file" 2>/dev/null
}

# Prints the reloaders to work on: the explicit names given, or every enabled
# reloader whose tool is installed.
_targets() {
    if [ $# -gt 0 ]; then
        for reloader in "$@"; do
            if [ -f "$base_dir/reloaders/$reloader" ]; then
                echo "$reloader"
            else
                warn "color-reloader: unknown reloader '$n'"
            fi
        done
        return 0
    fi

    for reloader_path in "$base_dir"/reloaders/*; do
        [ -f "$reloader_path" ] || continue
        reloader="${reloader_path##*/}"

        _is_disabled "$reloader" && continue
        ( _load_reloader "$reloader"; detect ) && echo "$reloader"
    done
}

_generate() {
    for generator in $1; do
        info "color-reloader: generating $generator"
        ( _load_reloader "$generator"; generate ) || {
            warn "color-reloader: '$generator' generate failed"
        }
    done
}

_reload() {
    for reloader in $1; do
        (
            info "color-reloader: reloading $reloader"
            _load_reloader "$reloader"
            reload >/dev/null 2>&1
            true
        ) &
    done
    wait
}


##
## Commands
##

# Rebuild palette, regenerate every config and reload every tool.
_cmd_apply() {
    _build_palette || return 1
    targets="$(_targets "$@")"
    _generate "$targets"
    _reload "$targets"
}

# Same as apply, but doesn't touch running programs (useful at boot).
_cmd_generate() {
    _build_palette || return 1
    _generate "$(_targets "$@")"
}

_cmd_set() {
    [ $# -eq 1 ] || {
        error "usage: color-reloader set <scheme>[/<mode>] | dark | light | toggle"
        return 1
    }
    _parse_theme

    case "$1" in
        dark|light) new="$scheme/$1" ;;
        toggle)
            if [ "$mode" = light ]; then new="$scheme/dark"; else new="$scheme/light"; fi
            ;;
        */*) new="$1" ;;
        *)   new="$1/$mode" ;;
    esac

    _scheme_exists "${new%%/*}" || {
        error "color-reloader: unknown scheme '${new%%/*}'"
        return 1
    }

    printf '%s\n' "$new" > "$theme_file.tmp" && mv "$theme_file.tmp" "$theme_file"

    # When the watcher is running it reacts to the file change by itself.
    _daemon_running || _cmd_apply
}

_daemon_running() {
    [ -f "$pidfile" ] || return 1
    pid="$(cat "$pidfile")"
    [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null
}

# Optional: re-applies whenever the theme file changes. Not needed if always
# change themes with `set`.
_cmd_watch() {
    command -v inotifywait >/dev/null 2>&1 || {
        error "color-reloader: inotifywait not found"
        return 1
    }

    if _daemon_running; then
        info "color-reloader: watcher already running"
        return 0
    fi

    echo "$$" > "$pidfile"
    inotify_pid=""
    trap 'rm -f "$pidfile"' EXIT
    trap '[ -n "$inotify_pid" ] && kill "$inotify_pid" 2>/dev/null; exit 0' INT TERM

    info "color-reloader: watching $theme_file (pid $$)"
    last=""
    while :; do
        current="$(_theme)"
        if [ "$current" != "$last" ]; then
            last="$current"
            _cmd_apply
            continue
        fi

        # Any event in the dir only wakes us up; the content comparison above
        # decides whether something really changed. The timeout is a safety net
        # for events that happen between the check and the next wait.
        inotifywait --quiet --timeout 300 \
            --event close_write --event moved_to "$theme_dir" >/dev/null 2>&1 &
        inotify_pid=$!
        wait "$inotify_pid" || sleep 1
        inotify_pid=""
    done
}

_cmd_stop() {
    if _daemon_running; then
        kill "$(cat "$pidfile")" && info "color-reloader: watcher stopped"
    else
        info "color-reloader: watcher not running"
    fi
}

_cmd_status() {
    _parse_theme

    if _daemon_running; then
        printf '\033[32m●\033[0m watcher running \033[2m(pid %s)\033[0m\n' "$(cat "$pidfile")"
    else
        printf '\033[31m○\033[0m watcher stopped\n'
    fi

    info "Theme: $scheme/$mode"
    info "Reloaders:"
    for reloader_path in "$base_dir"/reloaders/*; do
        [ -f "$reloader_path" ] || continue
        reloader="${reloader_path##*/}"

        if _is_disabled "$reloader"; then
            state='\033[2mdisabled\033[0m'
        elif ( _load_reloader "$reloader"; detect ); then
            state='\033[32mactive\033[0m'
        else
            state='\033[2mnot installed\033[0m'
        fi

        printf '  %-12s %b\n' "$reloader" "$state"
    done
}

_cmd_themes() {
    for colorscheme_path in "$base_dir"/color/*/; do
        [ -d "$colorscheme_path" ] || continue
        colorscheme="${colorscheme_path%/}"
        colorscheme="${colorscheme##*/}"

        modes=""
        for mode in "$colorscheme_path"*; do
            [ -f "$mode" ] && modes="$modes ${mode##*/}"
        done
        printf '%-16s%s\n' "$colorscheme" "$modes"
    done

    for provider in "$base_dir"/provider/*; do
        [ -f "$provider" ] && printf '%-16s%s\n' "${provider##*/}" " dark light (dynamic)"
    done
}

# has <name>: succeeds if the reloader exists and its tool is installed.
_cmd_has() {
    [ -f "$base_dir/reloaders/$1" ] && ( _load_reloader "$1"; detect )
}

_cmd_disable() {
    for reloader in "$@"; do
        [ -f "$base_dir/reloaders/$reloader" ] || {
            warn "color-reloader: unknown reloader '$reloader'"
            continue
        }

        _is_disabled "$reloader" || echo "$reloader" >> "$disabled_file"
        info "color-reloader: '$reloader' disabled"
    done
}

_cmd_enable() {
    for reloader in "$@"; do
        [ -f "$disabled_file" ] || break
        grep -vxF "$reloader" "$disabled_file" > "$disabled_file.tmp"
        mv "$disabled_file.tmp" "$disabled_file"
        info "color-reloader: '$reloader' enabled"
    done
}

# import <base16.yaml> <scheme>/<mode>: converts a tinted-theming scheme.
_cmd_import() {
    case "$2" in
        */*) ;;
        *) error "usage: color-reloader import <file.yaml> <scheme>/<mode>"; return 1 ;;
    esac

    dest="$base_dir/color/$2"
    mkdir -p "$(dirname "$dest")"
    sed -nE 's/^[[:space:]]*(base[0-9A-Fa-f]{2}):[[:space:]]*"?#?([0-9A-Fa-f]{6}).*/\1 \2/p' \
        "$1" > "$dest"

    if [ "$(wc -l < "$dest")" -lt 16 ]; then
        rm -f "$dest"
        error "color-reloader: '$1' doesn't look like a base16 scheme"
        return 1
    fi

    info "color-reloader: imported to color/$2"
}

_cmd_help() {
    echo "Usage: scripter color-reloader <command> [args...]"
    echo ""
    echo "Commands:"
    echo "  apply [names]         Rebuild palette, regenerate configs and reload tools (alias: reload)"
    echo "  generate [names]      Same, but without reloading running programs"
    echo "  set <theme>           Change theme: <scheme>[/<mode>] | dark | light | toggle"
    echo "  toggle                Toggle between dark and light"
    echo "  watch                 Re-apply when the theme file changes (alias: run)"
    echo "  stop                  Stop the watcher"
    echo "  status                Show theme and which reloaders are active"
    echo "  themes                List available schemes"
    echo "  has <name>            Succeeds if the reloader exists and its tool is installed"
    echo "  enable|disable        Opt reloaders in/out of the automatic detection"
    echo "  import <from> <to>    Import a base16 yaml scheme as <scheme>/<mode>"
    echo "  help                  Show this help message"
    echo ""
}

##
## Dispatch
##

cmd="help"
if [ $# -gt 0 ]; then
    cmd="$1"
    shift
fi

case "$cmd" in
    apply | reload)   _cmd_apply "$@" ;;
    generate)         _cmd_generate "$@" ;;
    set)              _cmd_set "$@" ;;
    toggle)           _cmd_set toggle ;;
    watch | run)      _cmd_watch ;;
    stop)             _cmd_stop ;;
    status)           _cmd_status ;;
    themes)           _cmd_themes ;;
    has)              _cmd_has "$1" ;;
    enable)           _cmd_enable "$@" ;;
    disable)          _cmd_disable "$@" ;;
    import)           _cmd_import "$@" ;;
    help | -h | --help) _cmd_help ;;
    *)
        error "color-reloader: unknown command '$cmd'!"
        _cmd_help
        exit 1
        ;;
esac

# vim: ft=sh
